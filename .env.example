# Google Gemini API Key (Required for AI Chinese translation & key points extraction)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (defaults to gemini-flash-lite-latest with automatic fallback chain)
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: Public access password to protect the web UI and maintenance APIs
# Leave empty to allow passwordless access on trusted LANs
ACCESS_PASSWORD=

# Optional: Timezone (defaults to Australia/Sydney)
TZ=Australia/Sydney

# Optional: Cron schedule for automatic news fetching (defaults to every 2 hours)
CRON_SCHEDULE=0 */2 * * *

# Optional: Max latest articles per Australian RSS feed (defaults to 10)
MAX_ITEMS_PER_FEED=10

# Optional: Max latest articles per Global RSS feed (defaults to 8)
MAX_ITEMS_PER_GLOBAL_FEED=8

# Optional: Storage watermark in GB before auto-pruning oldest historical articles (defaults to 10GB)
MAX_DB_SIZE_GB=10

# Optional: SQLite database file path (Docker defaults to /app/data/news.db)
DATABASE_PATH=./data/news.db
